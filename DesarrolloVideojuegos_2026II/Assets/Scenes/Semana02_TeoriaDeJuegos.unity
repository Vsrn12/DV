  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Satisfacci\xF3n - 5 - Vencer a un jefe tras varios intentos da una recompensa
    clara y muy gratificante.\n\nAprendizaje - 4 - Cada muerte ense\xF1a patrones
    de enemigos y sinergias de bendiciones, aunque el juego no explica todo.\n\nEficiencia
    - 4 - Controles precisos y respuesta inmediata, aunque los men\xFAs de mejoras
    pueden abrumar al inicio.\n\nInmersi\xF3n - 5 - Arte, m\xFAsica, narrativa y
    personajes hacen que el Inframundo se sienta vivo.\n\nMotivaci\xF3n - 5 - Cada
    intento fallido da progreso permanente e historia nueva, as\xED que siempre hay
    raz\xF3n para reintentar.\n\nEmoci\xF3n - 5 - Combates intensos, jefes exigentes
    y decisiones de riesgo generan tensi\xF3n y alivio constantes.\n\nSociabilidad
    - 2 - Es un juego de un solo jugador, sin cooperativo ni multijugador; la comunidad
    existe solo fuera del juego."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
